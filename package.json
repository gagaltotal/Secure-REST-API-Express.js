{
  "name": "secure-express-api",
  "version": "1.0.0",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node scripts/migrate.js",
    "db:migrate": "npx sequelize-cli db:migrate --config config/config.js",
    "db:seed": "npx sequelize-cli db:seed:all --config config/config.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "file-type": "^18.0.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.2.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^8.0.1",
    "sanitize-html": "^2.11.0",
    "sequelize": "^6.32.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "glob": "^13.0.6",
    "minimatch": "^10.2.2"
  }
}
