PORT=3000
APP_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secure_api_db
DB_USER=root
DB_PASS=password

JWT_SECRET=replace_this_with_strong_secret
JWT_EXPIRES_IN=1h

UPLOAD_DIR=uploads

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM=no-reply@example.com

# SSO (Single Sign-On) via OAuth2 / OpenID Connect
SSO_ENABLED=false
SSO_PROVIDER=generic
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_SCOPE=openid email profile
SSO_DEFAULT_ROLE=user